# Claude Code — local / user-specific
.claude/settings.local.json
.claude/*.local.json
.claude/.credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/
.python-version

# Node / TypeScript
node_modules/
dist/
*.tsbuildinfo

# MkDocs build output
/site/

# Skill/Agent catalog — generated by scripts/docs/gen_catalog.py (on_pre_build
# hook) into the canonical + fallback docs trees. Never commit catalog markdown,
# per spec/claude/skill-agent-catalog/ §Generation mechanism. The hand-curatable
# landing skeleton (by-task.md) is NOT regenerated once present and stays tracked.
/docs/en/skills/
/docs/en/agents/
/docs/en/references/tags.md
# Guard against a future canonical-language flip leaving stale generated
# catalog output behind in a non-canonical tree (as docs/de/ did before PR #32).
/docs/*/skills/
/docs/*/agents/
/docs/*/references/tags.md

# Task runner cache
.task/

# Audits — local-only, findings convert to issues/PRs
.audits/

# Vale — style packages fetched by `vale sync` (keep repo-local vocab)
.github/styles/*
!.github/styles/config/
.github/styles/config/vocabularies/*

# Environment
.env
.env.*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Worktree-local plan stubs / resumable-session aids (scripts/worktree_add.sh, task resume)
/.resume/
